{
  "name": "scruple-workspace",
  "version": "0.3.4",
  "private": true,
  "description": "Semantic code rules powered by typed decisions.",
  "homepage": "https://github.com/NAlexPear/scruple#readme",
  "bugs": {
    "url": "https://github.com/NAlexPear/scruple/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAlexPear/scruple.git"
  },
  "type": "module",
  "scripts": {
    "benchmark": "pnpm build 1>&2 && node packages/eval/dist/benchmark-cli.js",
    "benchmark-cache": "pnpm build 1>&2 && node packages/eval/dist/cache-benchmark-cli.js",
    "benchmark-codeql": "pnpm build 1>&2 && node packages/eval/dist/codeql-benchmark-cli.js",
    "benchmark-llm": "node --conditions=source packages/eval/src/llm-benchmark-cli.ts",
    "benchmark-semgrep": "pnpm build 1>&2 && node packages/eval/dist/semgrep-benchmark-cli.js",
    "benchmark-sonarqube": "node benchmarks/sonarqube/run.mjs",
    "build": "pnpm -r --sort build",
    "check": "oxfmt --check . && oxlint . && pnpm typecheck && pnpm build",
    "eval": "pnpm build && node packages/eval/dist/cli.js",
    "fix": "oxlint --fix . && oxfmt .",
    "release:version": "node scripts/set-release-version.ts",
    "scruple": "node --conditions=source packages/cli/src/bin.ts",
    "test": "pnpm build && node --test",
    "typecheck": "tsc --noEmit && pnpm --filter @scruple/docs typecheck"
  },
  "devDependencies": {
    "@scruple/cli": "workspace:*",
    "@scruple/core": "workspace:*",
    "@scruple/eval": "workspace:*",
    "@scruple/example-rules": "workspace:*",
    "@scruple/parser-go": "workspace:*",
    "@scruple/parser-oxc": "workspace:*",
    "@scruple/parser-python": "workspace:*",
    "@scruple/parser-rust": "workspace:*",
    "@scruple/parser-sql": "workspace:*",
    "@scruple/provider-cloudflare": "workspace:*",
    "@scruple/provider-decider": "workspace:*",
    "@scruple/provider-jev": "workspace:*",
    "@scruple/provider-kev": "workspace:*",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^7.0.2",
    "wrangler": "^4.137.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
