{
  "name": "scruple-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Semantic code rules powered by Jev or local Laya models.",
  "homepage": "https://github.com/NAlexPear/scruple#readme",
  "bugs": {
    "url": "https://github.com/NAlexPear/scruple/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAlexPear/scruple.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r --sort build",
    "check": "oxfmt --check . && oxlint . && tsc --noEmit && pnpm build && node --test",
    "eval": "pnpm build && node packages/eval/dist/cli.js",
    "fix": "oxlint --fix . && oxfmt .",
    "release:version": "node scripts/set-release-version.ts",
    "test": "pnpm build && node --test"
  },
  "devDependencies": {
    "@scruple/comments": "workspace:*",
    "@scruple/core": "workspace:*",
    "@scruple/eval": "workspace:*",
    "@scruple/parser-oxc": "workspace:*",
    "@scruple/provider-jev": "workspace:*",
    "@scruple/provider-laya": "workspace:*",
    "@scruple/relational-databases": "workspace:*",
    "@scruple/tests": "workspace:*",
    "@types/node": "^22.20.4",
    "@types/picomatch": "^4.0.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "scruple": "workspace:*",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.0.0"
}
