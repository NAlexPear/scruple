{
  "name": "@scruple/cli",
  "version": "0.1.0",
  "description": "Semantic code rules powered by pluggable parsers and decision providers.",
  "keywords": [
    "ai",
    "code-quality",
    "semantic-analysis",
    "static-analysis"
  ],
  "homepage": "https://github.com/NAlexPear/scruple#readme",
  "bugs": {
    "url": "https://github.com/NAlexPear/scruple/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NAlexPear/scruple.git",
    "directory": "packages/cli"
  },
  "bin": {
    "scruple": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scruple/core": "workspace:*",
    "jiti": "^2.6.1",
    "tinyglobby": "^0.2.15"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
