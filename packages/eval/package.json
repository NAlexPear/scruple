{
  "name": "@scruple/eval",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./benchmark": {
      "source": "./src/benchmark.ts",
      "types": "./dist/benchmark.d.ts",
      "import": "./dist/benchmark.js"
    },
    "./benchmark-options": {
      "source": "./src/benchmark-options.ts",
      "types": "./dist/benchmark-options.d.ts",
      "import": "./dist/benchmark-options.js"
    },
    "./codeql-benchmark": {
      "source": "./src/codeql-benchmark.ts",
      "types": "./dist/codeql-benchmark.d.ts",
      "import": "./dist/codeql-benchmark.js"
    },
    "./llm-benchmark": {
      "source": "./src/llm-benchmark.ts",
      "types": "./dist/llm-benchmark.d.ts",
      "import": "./dist/llm-benchmark.js"
    },
    "./openai-evaluator": {
      "source": "./src/openai-evaluator.ts",
      "types": "./dist/openai-evaluator.d.ts",
      "import": "./dist/openai-evaluator.js"
    },
    "./semgrep-benchmark": {
      "source": "./src/semgrep-benchmark.ts",
      "types": "./dist/semgrep-benchmark.d.ts",
      "import": "./dist/semgrep-benchmark.js"
    },
    "./semgrep-benchmark-options": {
      "source": "./src/semgrep-benchmark-options.ts",
      "types": "./dist/semgrep-benchmark-options.d.ts",
      "import": "./dist/semgrep-benchmark-options.js"
    },
    "./options": {
      "source": "./src/options.ts",
      "types": "./dist/options.d.ts",
      "import": "./dist/options.js"
    },
    "./plugins": {
      "source": "./src/plugins.ts",
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scruple/api-contracts": "workspace:*",
    "@scruple/async": "workspace:*",
    "@scruple/comments": "workspace:*",
    "@scruple/core": "workspace:*",
    "@scruple/errors": "workspace:*",
    "@scruple/observability": "workspace:*",
    "@scruple/parser-oxc": "workspace:*",
    "@scruple/provider-jev": "workspace:*",
    "@scruple/relational-databases": "workspace:*",
    "@scruple/resources": "workspace:*",
    "@scruple/security": "workspace:*",
    "@scruple/tests": "workspace:*"
  }
}
