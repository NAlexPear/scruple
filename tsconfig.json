{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "paths": {
      "@scruple/cli": ["./packages/cli/src/index.ts"],
      "@scruple/core": ["./packages/core/src/index.ts"],
      "@scruple/example-rules/*": ["./examples/rules/*/index.ts"],
      "@scruple/eval": ["./packages/eval/src/index.ts"],
      "@scruple/eval/benchmark": ["./packages/eval/src/benchmark.ts"],
      "@scruple/eval/benchmark-options": ["./packages/eval/src/benchmark-options.ts"],
      "@scruple/eval/cache-benchmark": ["./packages/eval/src/cache-benchmark.ts"],
      "@scruple/eval/codeql-benchmark": ["./packages/eval/src/codeql-benchmark.ts"],
      "@scruple/eval/llm-benchmark": ["./packages/eval/src/llm-benchmark.ts"],
      "@scruple/eval/openai-evaluator": ["./packages/eval/src/openai-evaluator.ts"],
      "@scruple/eval/semgrep-benchmark": ["./packages/eval/src/semgrep-benchmark.ts"],
      "@scruple/eval/semgrep-benchmark-options": [
        "./packages/eval/src/semgrep-benchmark-options.ts"
      ],
      "@scruple/eval/options": ["./packages/eval/src/options.ts"],
      "@scruple/eval/plugins": ["./packages/eval/src/plugins.ts"],
      "@scruple/parser-go": ["./packages/parser-go/src/index.ts"],
      "@scruple/parser-oxc": ["./packages/parser-oxc/src/index.ts"],
      "@scruple/parser-python": ["./packages/parser-python/src/index.ts"],
      "@scruple/parser-rust": ["./packages/parser-rust/src/index.ts"],
      "@scruple/parser-sql": ["./packages/parser-sql/src/index.ts"],
      "@scruple/provider-cloudflare": ["./packages/provider-cloudflare/src/index.ts"],
      "@scruple/provider-decider": ["./packages/provider-decider/src/index.ts"],
      "@scruple/provider-jev": ["./packages/provider-jev/src/index.ts"],
      "@scruple/provider-kev": ["./packages/provider-kev/src/index.ts"]
    },
    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": false,
    "types": ["node", "emscripten"],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["apps/docs/**", "**/dist/**", "**/node_modules/**"]
}
