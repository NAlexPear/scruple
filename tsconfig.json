{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "paths": {
      "@scruple/core": ["./packages/core/src/index.ts"],
      "@scruple/example-prefer-database-join": [
        "./packages/example-prefer-database-join/src/index.ts"
      ],
      "@scruple/example-unhelpful-comment": ["./packages/example-unhelpful-comment/src/index.ts"],
      "@scruple/example-vacuous-test": ["./packages/example-vacuous-test/src/index.ts"],
      "@scruple/parser-oxc": ["./packages/parser-oxc/src/index.ts"],
      "@scruple/provider-jev": ["./packages/provider-jev/src/index.ts"],
      "@scruple/provider-laya": ["./packages/provider-laya/src/index.ts"],
      "scruple": ["./packages/cli/src/index.ts"]
    },
    "strict": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedDeclarations": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": false,
    "types": ["node"],
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
